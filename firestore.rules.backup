rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User-isolated collection structure:
    // Only the authenticated user matching {uid} can read or write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // All 14 subcollections scoped under /users/{uid}/
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny all other production reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
